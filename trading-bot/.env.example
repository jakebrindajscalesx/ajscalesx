# Copy this file to .env and fill in real values. Never commit .env.
# Only needed when config.yaml mode is "live". Not needed for paper trading.
# These are your exchange.name credentials (Kraken by default) -- named
# generically because the bot supports whichever exchange config.yaml
# points at, not just one.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optional: enables trade alerts and manual /signal commands via Telegram.
# Create a bot with @BotFather, then message your bot once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
