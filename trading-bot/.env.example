# Copy this file to .env and fill in real values. Never commit .env.
# Required in BOTH paper and live mode -- unlike Kraken's public keyless
# data, Alpaca requires an API key/secret to fetch market data at all.
# Get free paper trading keys at https://alpaca.markets (create an account,
# then Paper Trading -> Generate New Keys). Use the PAPER keys here to
# start -- see the README before ever switching to live keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optional: enables trade alerts and manual /signal commands via Telegram.
# Create a bot with @BotFather, then message your bot once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
