# Copy to .env and fill in. Never commit .env -- it's in .gitignore.
# In CI (GitHub Actions) these are supplied as repo secrets instead;
# see the workflow file and README.md.

# Solana RPC + enhanced transaction history, from https://helius.dev (free
# tier is enough to start). Used both to read tracked wallets' recent swaps
# and to submit the bot's own transactions.
HELIUS_API_KEY=

# Optional. Fomoscope's free tier works per-IP without a key; a key gets you
# your own rate-limit bucket instead of sharing the public one. Get one at
# https://www.fomoscope.xyz/setup if you outgrow the free tier.
FOMOSCOPE_API_KEY=

# The wallet the bot trades from. WALLET_PUBLIC_KEY is safe to share.
# WALLET_PRIVATE_KEY is NOT -- treat it exactly like cash. Use a wallet
# dedicated to this bot only, funded with only what you're willing to lose,
# never your main wallet. See README.md "Wallet setup" before filling this in.
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=

# Reuse the same Telegram bot as ../trading-bot, or create a second one via
# @BotFather -- either works, but use a chat_id only you have access to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
